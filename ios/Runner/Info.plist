<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>FleetCheck</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.fleetCheck.evs</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>FleetCheck</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!-- Permissions -->
    <key>NSCameraUsageDescription</key>
    <string>FleetCheck needs camera access to scan vehicle QR codes for inspections.</string>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>FleetCheck needs your location to record where vehicle inspections take place.</string>

    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>FleetCheck needs your location to record where vehicle inspections take place.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>FleetCheck needs access to your photo library to update your profile picture.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>FleetCheck needs permission to save inspection reports to your photo library.</string>

    <key>NSFaceIDUsageDescription</key>
    <string>FleetCheck uses Face ID for quick and secure login.</string>

    <key>NSContactsUsageDescription</key>
    <string>FleetCheck does not access your contacts.</string>

    <!-- Lets downloaded inspection PDFs (saved under the app's Documents
         directory) show up in the iOS Files app under "On My iPhone". -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- UI -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Firebase -->
    <key>FirebaseAppDelegateProxyEnabled</key>
    <false/>

    <key>flutter_deeplinking_enabled</key>
    <true/>
</dict>
</plist>
